# ============================================
# LOCAL DEVELOPMENT
# ============================================
POSTGRES_PASSWORD="<local-postgres-password>"
DATABASE_URL="postgresql://cms:<local-postgres-password>@localhost:5432/university_cms?schema=public"
DIRECT_DATABASE_URL="postgresql://cms:<local-postgres-password>@localhost:5432/university_cms?schema=public"

# ============================================
# PRODUCTION (NEON + VERCEL)
# ============================================
# Uncomment và thay thế với connection strings từ Neon:
# DATABASE_URL="postgresql://user:pass@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
# DIRECT_DATABASE_URL="postgresql://user:pass@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&connect_timeout=10"

# ============================================
# SECURITY
# ============================================
# Tạo secret: openssl rand -base64 32
AUTH_SECRET="<generate-with-openssl-rand-base64-32>"
JWT_SECRET="<generate-with-openssl-rand-base64-32>"

# ============================================
# STORAGE (Optional)
# ============================================
# Vercel Blob upload token. Optional in local fallback mode.
BLOB_READ_WRITE_TOKEN=""

# ============================================
# REDIS (Optional)
# ============================================
# Optional cache endpoint for future scaling.
REDIS_URL="redis://localhost:6379"

# ============================================
# APP CONFIG
# ============================================
NEXT_PUBLIC_APP_NAME="Lightweight University CMS"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
